PORT=3000
# Postgres connection string, e.g. from Neon (Dashboard > Connect). Required.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Only needed when the frontend runs on another domain. Comma-separated.
ALLOWED_ORIGINS=

# One-time X tasks before the first game (follow, notifications, like, repost, reply).
# X_HANDLE defaults to FlipfightRH; set it to off to skip. Without X_TWEET_URL the like / repost / reply tasks point to the latest post on the profile.
X_HANDLE=FlipfightRH
X_TWEET_URL=
X_REPLY_TEXT=

# Coming-soon mode is OFF unless this is "on". When on, visitors see a teaser page; the game keeps running behind it.
COMING_SOON=off
# Secret for the preview link: open https://your-site/?preview=THIS_VALUE once to get into the game.
PREVIEW_KEY=
