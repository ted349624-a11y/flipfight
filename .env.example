PORT=3000
# Postgres connection string, e.g. from Neon (Dashboard > Connect). Required.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Only needed when the frontend runs on another domain. Comma-separated.
ALLOWED_ORIGINS=

# Coming-soon mode is ON unless this is "off". Visitors see a teaser page; the game keeps running behind it.
COMING_SOON=on
# Secret for the preview link: open https://your-site/?preview=THIS_VALUE once to get into the game.
PREVIEW_KEY=
